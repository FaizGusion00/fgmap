#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// Simulator hanya arm64. macOS 27 / Xcode 27 tidak lagi menyokong Mac Intel; slice x86_64 gagal dikompil
// (maplibre_gl) dan semakan seni bina Flutter 3.41 salah menolak Flutter.framework kerana susunan output
// `lipo -info` berubah. Peranti fizikal tidak terjejas (selalu arm64).
ARCHS[sdk=iphonesimulator*] = arm64
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64
