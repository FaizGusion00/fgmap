<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: tiada data app disalin ke awan atau ke peranti baharu. Sejarah carian, tempat disimpan
     (Rumah/Kerja), laporan dan simpanan lokasi ialah data peribadi yang kekal pada peranti ini sahaja. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
