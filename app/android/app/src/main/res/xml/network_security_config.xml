<?xml version="1.0" encoding="utf-8"?>
<!-- Semua trafik rangkaian mesti HTTPS (koordinat dan pertanyaan carian tidak boleh dihantar tanpa
     penyulitan). Hanya kepercayaan sistem; tiada pengecualian. Build debug menimpa fail ini dengan
     src/debug/res/xml/network_security_config.xml untuk pelayan pek tile setempat. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
